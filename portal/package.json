{
  "name": "portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit && eslint",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db --no-file-parallelism",
    "test:e2e": "playwright test --trace off",
    "test": "npm run test:unit && npm run test:db && npm run test:e2e",
    "db:start": "SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io supabase start -x studio,imgproxy,vector,logflare,realtime,storage-api,edge-runtime,supavisor,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "SUPABASE_INTERNAL_IMAGE_REGISTRY=docker.io supabase db reset",
    "env:local": "bash scripts/write-env.sh"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "marked": "^16.4.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "^2.18.2",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^2.62.10",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
